# ==============================================================================
# FIGHTER DOCTORS PLATFORM — CLOUD PRODUCTION ENVIRONMENT CONFIGURATION
# Matches Cloudflare Edge (WAF/Worker/R2) + Supabase (PostgreSQL/Auth/RLS)
# ==============================================================================

FIGHTERS_ENVIRONMENT=production
FIGHTERS_DEBUG=false
FIGHTERS_LOG_LEVEL=INFO

# ── Supabase PostgreSQL Database (Single Source of Truth) ─────────────────────
# URI from Supabase: Project Settings -> Database -> Connection string (URI)
# Use the pooled connection string (port 6543) or direct connection (port 5432)
FIGHTERS_DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require

# ── Supabase Cloud API & Auth ────────────────────────────────────────────────
FIGHTERS_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
FIGHTERS_SUPABASE_KEY=[YOUR-SUPABASE-PUBLISHABLE-KEY]

# ── Cloudflare Edge Gateway & Workers ─────────────────────────────────────────
FIGHTERS_CLOUDFLARE_ACCOUNT_ID=[YOUR-CLOUDFLARE-ACCOUNT-ID]
FIGHTERS_CLOUDFLARE_API_TOKEN=[YOUR-CLOUDFLARE-API-TOKEN]

# ── Cloudflare R2 Object Storage (Zero-Egress Encrypted Medical Packages) ────
# S3 Endpoint: https://[ACCOUNT_ID].r2.cloudflarestorage.com
FIGHTERS_R2_BUCKET_NAME=fighters-vault-packages
FIGHTERS_R2_ENDPOINT_URL=https://[YOUR-CLOUDFLARE-ACCOUNT-ID].r2.cloudflarestorage.com

# S3-compatible credentials from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
FIGHTERS_R2_ACCESS_KEY_ID=
FIGHTERS_R2_SECRET_ACCESS_KEY=

# Optional: Custom CDN Domain mapped to Cloudflare R2 bucket for edge acceleration
# e.g., https://assets.fighterdoctors.com
FIGHTERS_R2_PUBLIC_DOMAIN=
