# Fighters backend configuration (prefix FIGHTERS_*, see app/core/config.py).
# Copy to .env for local runs; never commit real secrets.

FIGHTERS_ENVIRONMENT=local
FIGHTERS_DEBUG=true
FIGHTERS_LOG_LEVEL=INFO

# Postgres (§12). docker compose up -d db creates this instance.
FIGHTERS_DATABASE_URL=postgresql+asyncpg://fighters:fighters@localhost:5432/fighters

# §75: clients below this version are refused when a critical security fix ships.
FIGHTERS_MINIMUM_SUPPORTED_APP_VERSION=0.0.0

# ── Cloudflare & Supabase Cloud Integration (Optional / Production) ──────────
# Supabase Database & Auth Keys
# FIGHTERS_SUPABASE_URL=https://your-project.supabase.co
# FIGHTERS_SUPABASE_KEY=your-supabase-publishable-key

# Cloudflare Edge Gateway & R2 Object Storage
# FIGHTERS_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# FIGHTERS_CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# FIGHTERS_R2_BUCKET_NAME=fighters-vault-packages
# FIGHTERS_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# FIGHTERS_R2_ACCESS_KEY_ID=your-r2-access-key-id
# FIGHTERS_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# FIGHTERS_R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com
